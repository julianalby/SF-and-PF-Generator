APP_NAME="SF/PF System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Timestamps are stored and shown in this timezone.
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database: SQLite file at database/database.sqlite ---------------------
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=DELETE
DB_SYNCHRONOUS=FULL

# --- Passwords: Argon2id ---------------------------------------------------
HASH_DRIVER=argon2id

# --- Sessions / cache / queue (no extra tables or services needed) ---------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# When the app is served over HTTPS, also set: SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- SF / PF sequences -----------------------------------------------------
# Only used when the number_sequences table is first created by the migration.
SF_START_NUMBER=26090119
PF_START_NUMBER=26090138

# --- Seeder (php artisan db:seed) -------------------------------------------
# Leave empty to get a random password per seeded user, printed once.
# Set it only for local development.
SEED_USER_PASSWORD=
